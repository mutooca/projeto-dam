<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nova Mensagem Local"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Seleção de Local -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Destino (Local)"
                android:textStyle="bold" />
            <Spinner
                android:id="@+id/spinnerLocais"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/corner"
                android:layout_marginTop="4dp" />

            <!-- Conteúdo -->
            <EditText
                android:id="@+id/inputTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Título do anúncio"
                android:background="@drawable/corner"
                android:padding="12dp"
                android:inputType="text" />

            <EditText
                android:id="@+id/inputMensagem"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="8dp"
                android:hint="Conteúdo da mensagem..."
                android:background="@drawable/corner"
                android:padding="12dp"
                android:gravity="top"
                android:inputType="textMultiLine" />

            <!-- Janela Temporal -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Janela Temporal (Opcional)"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <EditText
                    android:id="@+id/inputDataInicio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Início (AAAA-MM-DDTHH:MM)"
                    android:background="@drawable/corner"
                    android:padding="10dp"
                    android:textSize="12sp"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/inputDataFim"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:hint="Fim (AAAA-MM-DDTHH:MM)"
                    android:background="@drawable/corner"
                    android:padding="10dp"
                    android:textSize="12sp"
                    android:inputType="text" />
            </LinearLayout>

            <!-- Seção de Políticas -->
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DDD" android:layout_marginVertical="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Política de Visibilidade"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/radioGroupPolitica"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">
                <RadioButton android:id="@+id/radioWhitelist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Whitelist" android:checked="true" />
                <RadioButton android:id="@+id/radioBlacklist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Blacklist" android:layout_marginStart="16dp" />
            </RadioGroup>

            <EditText
                android:id="@+id/inputRestricoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Restrições (ex: clube=Real Madrid)"
                android:background="@drawable/corner"
                android:padding="12dp"
                android:textSize="14sp" />

            <!-- Modo de Entrega -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Modo de Entrega"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/radioGroupEntrega"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">
                <RadioButton android:id="@+id/radioCentralizado" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Centralizado" android:checked="true" />
                <RadioButton android:id="@+id/radioDescentralizado" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Descentralizado" android:layout_marginStart="16dp" />
            </RadioGroup>

            <Button
                android:id="@+id/btnPublicar"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="24dp"
                android:text="Publicar Anúncio"
                android:backgroundTint="@color/cor_app"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnTestarP2p"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Testar P2P"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
