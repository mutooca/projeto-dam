<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#F6F3F1">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- TÍTULO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Novo Anúncio"
                android:textColor="#0D132B"
                android:textSize="34sp"
                android:textStyle="bold" />

            <!-- SUBTÍTULO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Publique uma mensagem vinculada a uma infraestrutura"
                android:textColor="#747887"
                android:textSize="18sp" />

            <!-- LABEL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Infraestrutura / Local"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- SELECT LOCAL -->
            <LinearLayout
                android:id="@+id/btnSelecionarLocal"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_location" />

                <TextView
                    android:id="@+id/txtSelecionarLocal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="Seleccionar local"
                    android:textColor="#8A8F9C"
                    android:textSize="18sp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_down" />

            </LinearLayout>

            <!-- ADD LOCATION -->
            <TextView
                android:id="@+id/txtAdicionarLocal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="+ Adicionar nova localização"
                android:textColor="#348CEB"
                android:textSize="18sp" />

            <!-- TÍTULO DO ANÚNCIO -->
            <EditText
                android:id="@+id/edtTitulo"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_input"
                android:hint="Ex: Arrendo vivenda na Maianga"
                android:paddingHorizontal="20dp"
                android:textSize="18sp" />

            <!-- DESCRIÇÃO -->
            <EditText
                android:id="@+id/edtDescricao"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_input"
                android:gravity="top"
                android:hint="Escreva a sua mensagem de anúncio..."
                android:padding="20dp"
                android:textSize="18sp" />

            <!-- BOTÃO -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPublicarAnuncio"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="24dp"
                android:text="Publicar anúncio"
                android:textColor="#FFFFFF"
                app:cornerRadius="18dp"
                app:backgroundTint="#ED9408"/>

        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progressPostar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

</RelativeLayout>