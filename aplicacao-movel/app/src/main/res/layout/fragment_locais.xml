<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F3F1"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/headerLocais"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Infraestruturas"
            android:textColor="#0D132B"
            android:textSize="34sp"
            android:textStyle="bold" />

        <!-- SUBTÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Locais disponíveis para publicação de anúncios"
            android:textColor="#747887"
            android:textSize="18sp" />

        <!-- SEARCH -->
        <androidx.appcompat.widget.SearchView
            android:id="@+id/searchLocais"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_search" />

        <!-- FILTROS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_btn_selected"
                android:text="Todos"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_btn_unselected"
                android:text="GPS"
                android:textAllCaps="false"
                android:textColor="#747887" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_btn_unselected"
                android:text="WiFi"
                android:textAllCaps="false"
                android:textColor="#747887" />

        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressLocais"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

    <!-- LISTA -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerLocais"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerLocais"
        android:layout_marginTop="20dp"
        android:clipToPadding="false"
        android:paddingBottom="90dp" />

</RelativeLayout>