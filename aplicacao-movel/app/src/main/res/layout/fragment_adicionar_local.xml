<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragments.AdicionarLocal">

    <LinearLayout
        android:layout_width="380sp"
        android:layout_height="220sp"
        android:layout_marginTop="100sp"
        android:background="@drawable/branco"
        android:elevation="10dp"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20sp">

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Adicionar nova localização"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"

            />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Será associado a sua localização actual"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/local"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/corner"
            android:hint="Ex: Bairro Popular Rua-17"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <com.google.android.material.button.MaterialButton

            android:id="@+id/btnRec"
            android:layout_width="match_parent"
            android:layout_height="60sp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10sp"
            android:layout_marginEnd="16dp"
            android:text="+ Adicionar"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:backgroundTint="@color/cor_botao"
            android:elevation="10dp"/>

    </LinearLayout>
</FrameLayout>